# FOCUSFLOW API Configuration
PORT=4000
NODE_ENV=development

# Database (PostgreSQL via Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/focusflow?schema=public"

# Frontend Web Origin (for CORS)
WEB_ORIGIN="http://localhost:3000"

# Authentication Secrets (Generate strong random 64-char strings in production)
JWT_ACCESS_SECRET="focusflow-access-secret-placeholder-min-32-chars"
JWT_REFRESH_SECRET="focusflow-refresh-secret-placeholder-min-32-chars"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# AI Productivity Coach Integration
AI_PROVIDER="gemini" # or "openai"
AI_API_KEY="your-server-side-gemini-or-openai-api-key"
